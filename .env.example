# ---------------------------------------------------------------------------
# PHISHGUARD environment template. Copy to `.env` and fill in.
# NEVER commit real values. Service-role and API keys are server-side only.
# ---------------------------------------------------------------------------

# development | staging | production
ENV=development
LOG_LEVEL=INFO

# --- apps/web (browser-visible) ---------------------------------------------
# Only NEXT_PUBLIC_* values reach the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- apps/web (server-only) -------------------------------------------------
ANALYSIS_API_URL=http://localhost:8000
ANALYSIS_SERVICE_TOKEN=dev-only-change-me-please

# --- services/analysis ------------------------------------------------------
# memory (default, no credentials needed) | supabase
PERSISTENCE=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=dev-only-change-me-please
ALLOWED_ORIGINS=http://localhost:3000
# Rate limits (requests per minute)
RATE_LIMIT_ANON_PER_MIN=10
RATE_LIMIT_USER_PER_MIN=30
MAX_CONCURRENT_SCANS=8

# Threat intelligence. Absent keys are reported as "skipped", never "safe".
# Keys are server-only; never expose them through NEXT_PUBLIC_* or the extension.
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_API_KEY=
# Bounded provider behaviour (defaults shown).
INTEL_HTTP_TIMEOUT_SECONDS=5
INTEL_MAX_RESPONSE_BYTES=256000
INTEL_MAX_RETRIES=1
INTEL_CACHE_ENABLED=true
INTEL_SAFE_BROWSING_CACHE_TTL_SECONDS=3600
INTEL_URLHAUS_CACHE_TTL_SECONDS=21600

# Certificate Transparency via crt.sh. Off by default; enable per deployment.
# A CT failure is reported as partial/unavailable, never as a safe result.
CT_ENABLED=false
CT_TIMEOUT_SECONDS=5
CT_MAX_RESPONSE_BYTES=1000000
CT_MAX_RECORDS=1000

# --- services/ml ------------------------------------------------------------
FEATURE_CONTRACT_PATH=artifacts/feature_contract.json
MODEL_PATH=artifacts/model.joblib

# --- training only (M2) -----------------------------------------------------
PHIUSIIL_CSV=PhiUSIIL_Phishing_URL_Dataset.csv

# --- test-only escape hatch (MUST never be set in production) ---------------
# SCANNER_ALLOW_LOOPBACK_FOR_TESTS=1
