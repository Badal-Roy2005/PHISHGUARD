{
  "name": "@phishguard/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for PHISHGUARD wire contracts (JSON Schema + types + validators)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
