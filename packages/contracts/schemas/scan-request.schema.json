{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phishguard.local/schemas/scan-request.schema.json",
  "title": "ScanRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^[hH][tT][tT][pP][sS]?://",
      "description": "Absolute http(s) URL. Validated by the API before any DNS or fetch."
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_intel": { "type": "boolean", "default": true },
        "include_ct": {
          "type": "boolean",
          "default": false,
          "description": "Certificate Transparency lookup. Off by default: slow and rate limited."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 15000,
          "default": 8000
        }
      }
    }
  }
}
