{
  "name": "phishguard",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-layer phishing detection with explainable risk scoring",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @phishguard/web dev",
    "build": "pnpm --filter @phishguard/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:py": "bash scripts/lint-python.sh",
    "test": "pnpm -r --if-present test",
    "test:py": "bash scripts/test-python.sh",
    "test:rls": "bash scripts/test-rls.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
